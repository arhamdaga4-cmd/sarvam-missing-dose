# ---------------------------------------------------------------------------
# Sarvam - only the sk_... subscription key is needed.
# Create it at https://dashboard.sarvam.ai (API Keys -> create, copy immediately).
# The X-API-Key from the hosted voice-agent product is NOT used here.
# ---------------------------------------------------------------------------
SARVAM_API_KEY=sk_your_key_here
# SARVAM_CHAT_MODEL=sarvam-105b-conversations
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=anushka
# SARVAM_STT_MODEL=saaras:v4

# ---------------------------------------------------------------------------
# Exotel (only for real phone calls)
# ---------------------------------------------------------------------------
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
# Either a bridge number Exotel dials first...
EXOTEL_BRIDGE_NUMBER=
# ...or a call flow URL containing a Voicebot applet pointed at /stream
EXOTEL_FLOW_URL=

# Public URL of this server (ngrok or a VPS)
PUBLIC_BASE_URL=
PUBLIC_WS_URL=

# ---------------------------------------------------------------------------
# Audio / VAD
# ---------------------------------------------------------------------------
TELEPHONY_SAMPLE_RATE=8000
VAD_RMS_THRESHOLD=450
VAD_SILENCE_FRAMES=35
MAX_UTTERANCE_SECONDS=30

# ---------------------------------------------------------------------------
# Scheduler
# ---------------------------------------------------------------------------
SCHEDULE_TIME=09:30
SCHEDULE_TIMEZONE=Asia/Kolkata
SCHEDULER_POLL_SECONDS=60
SCHEDULER_RETRY_HOURS=3

# ---------------------------------------------------------------------------
# Coordinator notifications (all optional)
# ---------------------------------------------------------------------------
COORDINATOR_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Storage (defaults to ./data)
# DATA_DIR=./data
